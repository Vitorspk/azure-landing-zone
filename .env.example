# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env and fill with your actual values
# DO NOT commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env  # Load variables into your shell
# ==============================================================================

# Azure Subscription Configuration
export ARM_SUBSCRIPTION_ID="your-subscription-id"
export ARM_TENANT_ID="your-tenant-id"

# Azure Service Principal (if using)
# export ARM_CLIENT_ID="your-client-id"
# export ARM_CLIENT_SECRET="your-client-secret"

# Terraform Variables
export TF_VAR_resource_group_name="rg-network"
export TF_VAR_location="brazilsouth"
export TF_VAR_deploy_clusters="dev"  # or "dev,stg" or "all"

# Azure CLI Configuration
export AZURE_DEFAULTS_LOCATION="brazilsouth"

# Terraform Backend (if using remote state)
export TF_BACKEND_RESOURCE_GROUP="rg-terraform-state"
export TF_BACKEND_STORAGE_ACCOUNT="sttfstate"
export TF_BACKEND_CONTAINER="tfstate"

# GitHub Actions (for CI/CD)
# Note: These should be set as GitHub Secrets, not in local .env
# export AZURE_SUBSCRIPTION_ID="${ARM_SUBSCRIPTION_ID}"
# export AZURE_TENANT_ID="${ARM_TENANT_ID}"
# export AZURE_CLIENT_ID="${ARM_CLIENT_ID}"
# export AZURE_CLIENT_SECRET="${ARM_CLIENT_SECRET}"

# ==============================================================================
# SECURITY WARNING
# ==============================================================================
# NEVER commit .env file with real values!
# This file is in .gitignore for your protection
# Always use GitHub Secrets for CI/CD pipelines
# ==============================================================================

# ==============================================================================
# HOW TO GET THESE VALUES
# ==============================================================================
#
# Subscription ID:
#   az account show --query id -o tsv
#
# Tenant ID:
#   az account show --query tenantId -o tsv
#
# Create Service Principal (if needed):
#   az ad sp create-for-rbac --name "terraform-deployer" --role "Owner"
#
# ==============================================================================
